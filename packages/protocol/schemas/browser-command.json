{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virgil.dev/desk/browser-command.json",
  "type": "object",
  "required": ["command_id", "run_id", "op"],
  "properties": {
    "command_id": { "type": "string" },
    "run_id": { "type": "string" },
    "op": {
      "enum": [
        "captureHandoffSnapshot",
        "openTab",
        "duplicateTab",
        "closeTab",
        "scroll",
        "scrape",
        "screenshot",
        "observe",
        "probe_form",
        "probe_links",
        "probe_table",
        "click",
        "fill",
        "key",
        "wait",
        "focusTab"
      ]
    },
    "human_tab_id": { "type": "integer" },
    "tab_id": { "type": "integer" },
    "url": { "type": "string" },
    "handoff_url": { "type": "string" },
    "verify_level": { "enum": ["read", "action", "handoff"] },
    "params": {
      "type": "object",
      "properties": {
        "placement": {
          "enum": ["agent", "human"],
          "description": "openTab only: agent (default, Virgil · Agent group) or human (outside group)"
        }
      },
      "additionalProperties": true
    },
    "skip_screenshot": { "type": "boolean" }
  }
}
