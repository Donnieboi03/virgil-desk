{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://virgil.dev/desk/work-item.json",
  "type": "object",
  "required": ["id", "column", "title", "source", "status"],
  "properties": {
    "id": { "type": "string" },
    "column": { "enum": ["you", "agent", "waiting"] },
    "title": { "type": "string" },
    "status": { "enum": ["proposed", "running", "done", "failed", "denied"] },
    "parent_id": { "type": "string" },
    "kind": { "enum": ["parent", "subtask"], "default": "parent" },
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["handoff", "inbox", "calendar"] },
        "url": { "type": "string" },
        "ref": { "type": "string" }
      }
    },
    "hints": {
      "type": "object",
      "properties": {
        "search_query": { "type": "string" },
        "sender": { "type": "string" },
        "subject_contains": { "type": "string" }
      }
    }
  }
}
